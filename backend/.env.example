# ==========================================
# ENTERPRISE LOCAL AI ASSISTANT CONFIGURATION
# ==========================================

# Application Settings
PROJECT_NAME="Enterprise Local AI Assistant"
API_V1_STR="/api/v1"
DEBUG=True
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# PostgreSQL Relational Database
# Format: postgresql://username:password@hostname:port/database_name
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/enterprise_ai_db

# Security & JWT Token
# Generate a secret key in terminal using: openssl rand -hex 32
JWT_SECRET_KEY=CHANGE_THIS_TO_A_SECURE_RANDOM_SECRET_KEY_FOR_JWT
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Vector Database (ChromaDB)
CHROMA_PERSIST_DIRECTORY=./chroma_data
CHROMA_COLLECTION_NAME=enterprise_knowledge_base

# Local AI Runtime (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=qwen2.5:3b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_TEMPERATURE=0.1
OLLAMA_TOP_P=0.9
OLLAMA_CONTEXT_WINDOW=4096

# RAG Settings
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.55
CHUNK_SIZE=700
CHUNK_OVERLAP=120

# File Storage
UPLOAD_DIRECTORY=./uploads
MAX_UPLOAD_SIZE_MB=25
